{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "musix",
  "version": "0.1.0",
  "identifier": "com.musix.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "musix",
        "width": 256,
        "height": 256,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": false,
        "fullscreen": false,
        "maximizable": false,
        "shadow": false,
        "dragDropEnabled": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["WebView2Loader.dll"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": ["mp3", "wav", "flac", "ogg", "m4a", "aac"],
        "name": "Audio File",
        "description": "Play with Musix",
        "role": "Viewer"
      }
    ]
  }
}
